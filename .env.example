# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database URL (Server-only, for Vercel)
DATABASE_URL=postgresql://user:password@host:port/database

# SMTP Configuration for OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@example.com

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_live_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxx

# Public site URL (live)
SITE_URL=https://www.dmhca.in
VITE_SITE_URL=https://www.dmhca.in

# Loan Partner Configuration
LOAN_PARTNER_URL=https://app.jodo.in/your-partner/login
VITE_LOAN_PARTNER_URL=https://app.jodo.in/your-partner/login

# Session Secret (Generate a secure random string)
SESSION_SECRET=your-secure-random-string-here

# CRM intake (server-only; use your deployed HTTPS domain in production)
CRM_BASE_URL=https://crm.example.com
CRM_SOURCE_ID=contact-source-id
CRM_SOURCE_API_KEY=contact-source-api-key
CRM_CHATBOT_SOURCE_ID=chatbot-source-id
CRM_CHATBOT_SOURCE_API_KEY=chatbot-source-api-key
CRM_INTAKE_SIGNING_KEY=shared-signing-key-string
# Optional: must exactly match an Allowed origin configured in CRM
# CRM_ORIGIN=https://www.dmhca.in
